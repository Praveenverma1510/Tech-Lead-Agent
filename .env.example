# =============================================================================
# AI Tech Lead Agent - environment configuration
# Copy this file to `.env` and fill in the values you need.
# Never commit your real .env file.
# =============================================================================

# Which provider to use: groq | openrouter | gemini | ollama
LLM_PROVIDER=groq

# --- Groq (default, recommended - free & fast) --------------------------------
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (optional) -----------------------------------------------------
# Get a free API key at https://openrouter.ai/keys - use a model with a ":free" suffix
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Gemini (optional) ----------------------------------------------------------
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Ollama (optional, fully local, no key needed) -------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- General behaviour -----------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3
LLM_TEMPERATURE=0.3
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
